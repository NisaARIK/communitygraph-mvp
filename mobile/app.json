{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "./assets/Neon CommunityGraph Network Logo.png"
    "userInterfaceStyle": "light",
    "plugins": [
  [
    "expo-splash-screen",
    {
      "image": "./assets/Neon CommunityGraph Network Logo.png",
      "imageWidth": 200,
      "resizeMode": "contain",
      "backgroundColor": "#10052B"
    }
  ]
],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "./assets/Neon CommunityGraph Network Logo.png"
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-splash-screen"
    ]
  }
}
